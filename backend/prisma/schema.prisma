// Prisma Schema for Multi-Tenant SaaS ERP Platform
// Each table with business data includes organizationId for tenant isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PLATFORM CORE TABLES (Multi-Tenant Infrastructure)
// ============================================================================

// ERP Types: School, Manufacturing, Retail, Hospital, General
model ErpType {
  id          String   @id @default(cuid())
  code        String   @unique // school, manufacturing, retail, hospital, general
  name        String   // School ERP, Manufacturing ERP, etc.
  description String?
  icon        String?  // Icon name for UI
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  erpTypeModules  ErpTypeModule[]
  organizations   Organization[]
  menuItems       MenuItem[]

  @@map("erp_types")
}

// Available Modules in the platform
model Module {
  id           String   @id @default(cuid())
  code         String   @unique // inventory, finance, hr, students, production, etc.
  name         String   // Inventory Management, Finance, etc.
  description  String?
  category     String   // platform, core, school, manufacturing, retail, hospital
  icon         String?
  isCore       Boolean  @default(false) // Core modules are always included
  dependencies String[] // Module codes this depends on
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  erpTypeModules      ErpTypeModule[]
  organizationModules OrganizationModule[]
  permissions         Permission[]
  menuItems           MenuItem[]

  @@map("modules")
}

// Default modules for each ERP type
model ErpTypeModule {
  id         String  @id @default(cuid())
  erpTypeId  String
  moduleId   String
  isRequired Boolean @default(false) // Cannot be disabled
  isDefault  Boolean @default(true)  // Enabled by default

  erpType ErpType @relation(fields: [erpTypeId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([erpTypeId, moduleId])
  @@map("erp_type_modules")
}

// Subscription Plans
model Plan {
  id            String   @id @default(cuid())
  code          String   @unique // starter, growth, enterprise
  name          String   // Starter, Growth, Enterprise
  description   String?
  priceMonthly  Decimal  @db.Decimal(10, 2)
  priceYearly   Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  maxUsers      Int      // -1 for unlimited
  maxBranches   Int      // -1 for unlimited
  maxModules    Int      // -1 for unlimited
  storageGB     Int      // Storage limit in GB
  features      Json     // Additional features as JSON
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

// ============================================================================
// ORGANIZATION / TENANT TABLES
// ============================================================================

// Organization (Tenant) - Each customer is an organization
model Organization {
  id              String   @id @default(cuid())
  code            String   @unique // Auto-generated unique code
  name            String
  slug            String   @unique // URL-friendly name
  email           String
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String   @default("India")
  pincode         String?
  logo            String?
  website         String?
  taxId           String?  // GST Number
  erpTypeId       String
  timezone        String   @default("Asia/Kolkata")
  dateFormat      String   @default("DD/MM/YYYY")
  currency        String   @default("INR")
  financialYearStart Int   @default(4) // April = 4
  isActive        Boolean  @default(true)
  isOnboarded     Boolean  @default(false)
  settings        Json?    // Additional settings
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  erpType             ErpType              @relation(fields: [erpTypeId], references: [id])
  branches            Branch[]
  users               User[]
  roles               Role[]
  organizationModules OrganizationModule[]
  subscription        Subscription?
  auditLogs           AuditLog[]
  customFields        CustomField[]
  documentSequences   DocumentSequence[]
  workflows           Workflow[]

  // Core Module Relations
  accounts         Account[]
  journals         JournalEntry[]
  invoices         Invoice[]
  payments         Payment[]
  products         Product[]
  categories       Category[]
  warehouses       Warehouse[]
  stockMovements   StockMovement[]
  employees        Employee[]
  departments      Department[]
  attendances      Attendance[]
  vendors          Vendor[]
  purchaseOrders   PurchaseOrder[]
  customers        Customer[]
  salesOrders      SalesOrder[]

  // School Module Relations
  students         Student[]
  teachers         Teacher[]
  classes          Class[]
  subjects         Subject[]
  exams            Exam[]
  feeStructures    FeeStructure[]

  // Manufacturing Module Relations
  boms             BillOfMaterial[]
  workOrders       WorkOrder[]
  productionEntries ProductionEntry[]
  qualityChecks    QualityCheck[]
  machines         Machine[]

  // Retail Module Relations
  stores           Store[]
  posSessions      PosSession[]
  promotions       Promotion[]

  // Hospital Module Relations
  patients         Patient[]
  doctors          Doctor[]
  appointments     Appointment[]

  @@map("organizations")
}

// Branch - Multiple locations for an organization
model Branch {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  address        String?
  city           String?
  state          String?
  phone          String?
  email          String?
  isHeadOffice   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  warehouses   Warehouse[]
  stores       Store[]

  @@unique([organizationId, code])
  @@map("branches")
}

// Modules enabled for each organization
model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  isEnabled      Boolean  @default(true)
  enabledAt      DateTime @default(now())
  settings       Json?    // Module-specific settings

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@map("organization_modules")
}

// Subscription for organization
model Subscription {
  id               String    @id @default(cuid())
  organizationId   String    @unique
  planId           String
  status           String    @default("active") // active, cancelled, expired, trial
  billingCycle     String    @default("monthly") // monthly, yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt      DateTime?
  cancelledAt      DateTime?
  razorpaySubId    String?   // Razorpay subscription ID
  razorpayCustomerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan              @relation(fields: [planId], references: [id])
  payments     SubscriptionPayment[]

  @@map("subscriptions")
}

// Subscription Payment History
model SubscriptionPayment {
  id              String   @id @default(cuid())
  subscriptionId  String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("INR")
  status          String   // pending, success, failed
  razorpayPaymentId String?
  razorpayOrderId   String?
  invoiceUrl      String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

// ============================================================================
// USER & ACCESS CONTROL
// ============================================================================

// Platform Users
model User {
  id             String    @id @default(cuid())
  organizationId String?   // Null for platform admins
  branchId       String?   // Optional branch assignment
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  isActive       Boolean   @default(true)
  isEmailVerified Boolean  @default(false)
  isPlatformAdmin Boolean  @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id])
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]

  @@map("users")
}

// Refresh Tokens
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Roles (Organization-specific)
model Role {
  id             String   @id @default(cuid())
  organizationId String?  // Null for system roles
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false) // Cannot be deleted
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

// User-Role mapping
model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// Permissions
model Permission {
  id          String  @id @default(cuid())
  moduleId    String?
  code        String  @unique // module.action e.g., inventory.view, inventory.create
  name        String
  description String?
  action      String  // view, create, update, delete, export, approve

  module          Module?          @relation(fields: [moduleId], references: [id])
  rolePermissions RolePermission[]

  @@map("permissions")
}

// Role-Permission mapping
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// MENU SYSTEM
// ============================================================================

// Dynamic Menu Items
model MenuItem {
  id         String  @id @default(cuid())
  parentId   String?
  moduleId   String?
  erpTypeId  String? // If specific to an ERP type
  code       String  @unique
  name       String
  icon       String?
  path       String? // Frontend route
  permission String? // Required permission to see
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuHierarchy")
  module   Module?    @relation(fields: [moduleId], references: [id])
  erpType  ErpType?   @relation(fields: [erpTypeId], references: [id])

  @@map("menu_items")
}

// ============================================================================
// CONFIGURATION & SETTINGS
// ============================================================================

// Custom Fields for flexibility
model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String   // customer, product, invoice, etc.
  fieldName      String
  fieldLabel     String
  fieldType      String   // text, number, date, select, checkbox
  options        Json?    // For select type
  isRequired     Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, fieldName])
  @@map("custom_fields")
}

// Document Sequences (Auto-numbering)
model DocumentSequence {
  id             String   @id @default(cuid())
  organizationId String
  documentType   String   // invoice, purchase_order, payment, etc.
  prefix         String   // INV-, PO-, PAY-
  suffix         String?
  currentNumber  Int      @default(0)
  padLength      Int      @default(5) // INV-00001
  resetYearly    Boolean  @default(true)
  lastResetYear  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType])
  @@map("document_sequences")
}

// ============================================================================
// WORKFLOW ENGINE
// ============================================================================

model Workflow {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  documentType   String   // purchase_order, leave_request, etc.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]

  @@map("workflows")
}

model WorkflowStep {
  id          String  @id @default(cuid())
  workflowId  String
  stepOrder   Int
  name        String
  approverType String // role, user, manager
  approverId  String? // Role ID or User ID
  condition   Json?   // Conditions for this step

  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approvals  Approval[]

  @@map("workflow_steps")
}

model Approval {
  id             String    @id @default(cuid())
  workflowStepId String
  documentType   String
  documentId     String
  status         String    @default("pending") // pending, approved, rejected
  approvedBy     String?
  comments       String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String   // create, update, delete, login, etc.
  entityType     String   // user, invoice, product, etc.
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// CORE MODULE: FINANCE
// ============================================================================

model Account {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String   // asset, liability, equity, income, expense
  parentId       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]      @relation("AccountHierarchy")
  journalLines   JournalLine[]

  @@unique([organizationId, code])
  @@map("accounts")
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  entryNumber    String
  date           DateTime
  reference      String?
  narration      String?
  status         String   @default("draft") // draft, posted, cancelled
  createdBy      String
  postedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        JournalLine[]

  @@unique([organizationId, entryNumber])
  @@map("journal_entries")
}

model JournalLine {
  id            String  @id @default(cuid())
  journalId     String
  accountId     String
  debit         Decimal @default(0) @db.Decimal(15, 2)
  credit        Decimal @default(0) @db.Decimal(15, 2)
  description   String?

  journal JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  invoiceNumber  String
  type           String   // sales, purchase
  customerId     String?
  vendorId       String?
  date           DateTime
  dueDate        DateTime
  subtotal       Decimal  @db.Decimal(15, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal  @db.Decimal(15, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(15, 2)
  status         String   @default("draft") // draft, sent, paid, partial, cancelled
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id])
  vendor       Vendor?         @relation(fields: [vendorId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(15, 3)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(15, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  paymentNumber  String
  invoiceId      String?
  type           String   // received, made
  customerId     String?
  vendorId       String?
  amount         Decimal  @db.Decimal(15, 2)
  paymentDate    DateTime
  paymentMethod  String   // cash, bank, upi, card
  reference      String?
  notes          String?
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  @@unique([organizationId, paymentNumber])
  @@map("payments")
}

// ============================================================================
// CORE MODULE: INVENTORY
// ============================================================================

model Category {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryHierarchy")
  products     Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?
  categoryId     String?
  type           String   @default("goods") // goods, service
  unit           String   @default("pcs")
  purchasePrice  Decimal  @default(0) @db.Decimal(15, 2)
  sellingPrice   Decimal  @default(0) @db.Decimal(15, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  hsnCode        String?
  reorderLevel   Int      @default(0)
  image          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id])
  stocks          Stock[]
  stockMovements  StockMovement[]
  invoiceItems    InvoiceItem[]
  purchaseItems   PurchaseOrderItem[]
  salesOrderItems SalesOrderItem[]
  bomItems        BomItem[]

  @@unique([organizationId, sku])
  @@map("products")
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  code           String
  name           String
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id])
  stocks         Stock[]
  stockMovements StockMovement[]

  @@unique([organizationId, code])
  @@map("warehouses")
}

model Stock {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(15, 3)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stocks")
}

model StockMovement {
  id              String   @id @default(cuid())
  organizationId  String
  productId       String
  warehouseId     String
  type            String   // in, out, transfer, adjustment
  quantity        Decimal  @db.Decimal(15, 3)
  referenceType   String?  // purchase_order, sales_order, production, etc.
  referenceId     String?
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@map("stock_movements")
}

// ============================================================================
// CORE MODULE: HR
// ============================================================================

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  parentId       String?
  managerId      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DeptHierarchy")
  employees    Employee[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Employee {
  id             String    @id @default(cuid())
  organizationId String
  employeeCode   String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  departmentId   String?
  designation    String?
  joiningDate    DateTime
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  salary         Decimal?  @db.Decimal(15, 2)
  bankAccount    String?
  bankIfsc       String?
  panNumber      String?
  aadharNumber   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id])
  attendances  Attendance[]

  @@unique([organizationId, employeeCode])
  @@map("employees")
}

model Attendance {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  status         String    // present, absent, half_day, leave, holiday
  notes          String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

// ============================================================================
// CORE MODULE: PROCUREMENT
// ============================================================================

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  gstNumber      String?
  panNumber      String?
  bankAccount    String?
  bankIfsc       String?
  creditLimit    Decimal? @db.Decimal(15, 2)
  creditDays     Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  payments       Payment[]

  @@unique([organizationId, code])
  @@map("vendors")
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  organizationId String
  orderNumber    String
  vendorId       String
  date           DateTime
  expectedDate   DateTime?
  subtotal       Decimal  @db.Decimal(15, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal  @db.Decimal(15, 2)
  status         String   @default("draft") // draft, sent, partial, received, cancelled
  notes          String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  items        PurchaseOrderItem[]

  @@unique([organizationId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal @db.Decimal(15, 3)
  receivedQty     Decimal @default(0) @db.Decimal(15, 3)
  unitPrice       Decimal @db.Decimal(15, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  amount          Decimal @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// ============================================================================
// CORE MODULE: SALES
// ============================================================================

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  gstNumber      String?
  creditLimit    Decimal? @db.Decimal(15, 2)
  creditDays     Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrders  SalesOrder[]
  invoices     Invoice[]
  payments     Payment[]

  @@unique([organizationId, code])
  @@map("customers")
}

model SalesOrder {
  id             String   @id @default(cuid())
  organizationId String
  orderNumber    String
  customerId     String
  date           DateTime
  deliveryDate   DateTime?
  subtotal       Decimal  @db.Decimal(15, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal  @db.Decimal(15, 2)
  status         String   @default("draft") // draft, confirmed, partial, delivered, cancelled
  notes          String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id])
  items        SalesOrderItem[]

  @@unique([organizationId, orderNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String  @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Decimal @db.Decimal(15, 3)
  deliveredQty Decimal @default(0) @db.Decimal(15, 3)
  unitPrice    Decimal @db.Decimal(15, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  discount     Decimal @default(0) @db.Decimal(15, 2)
  amount       Decimal @db.Decimal(15, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

// ============================================================================
// INDUSTRY MODULE: SCHOOL
// ============================================================================

model Class {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // Class 1, Class 2, etc.
  section        String?  // A, B, C
  academicYear   String   // 2024-25
  teacherId      String?  // Class teacher
  roomNumber     String?
  capacity       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      Teacher?     @relation(fields: [teacherId], references: [id])
  students     Student[]
  subjects     ClassSubject[]
  exams        Exam[]
  feeStructures FeeStructure[]

  @@unique([organizationId, name, section, academicYear])
  @@map("classes")
}

model Student {
  id             String    @id @default(cuid())
  organizationId String
  admissionNo    String
  rollNo         String?
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  classId        String?
  bloodGroup     String?
  address        String?
  city           String?
  state          String?
  photo          String?
  // Guardian Info
  guardianName   String?
  guardianRelation String?
  guardianPhone  String?
  guardianEmail  String?
  guardianOccupation String?
  // Admission Info
  admissionDate  DateTime
  previousSchool String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class?         @relation(fields: [classId], references: [id])
  examResults  ExamResult[]
  feePayments  FeePayment[]

  @@unique([organizationId, admissionNo])
  @@map("students")
}

model Teacher {
  id             String   @id @default(cuid())
  organizationId String
  employeeCode   String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  qualification  String?
  specialization String?
  joiningDate    DateTime
  salary         Decimal? @db.Decimal(15, 2)
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classes       Class[]
  classSubjects ClassSubject[]

  @@unique([organizationId, employeeCode])
  @@map("teachers")
}

model Subject {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]
  examSubjects  ExamSubject[]

  @@unique([organizationId, code])
  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model Exam {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // Mid Term, Final, Unit Test
  classId        String
  academicYear   String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class         @relation(fields: [classId], references: [id])
  subjects     ExamSubject[]
  results      ExamResult[]

  @@map("exams")
}

model ExamSubject {
  id          String   @id @default(cuid())
  examId      String
  subjectId   String
  maxMarks    Decimal  @db.Decimal(5, 2)
  passingMarks Decimal @db.Decimal(5, 2)
  examDate    DateTime?

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([examId, subjectId])
  @@map("exam_subjects")
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  subjectId     String
  marksObtained Decimal? @db.Decimal(5, 2)
  grade         String?
  remarks       String?
  createdAt     DateTime @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
  @@map("exam_results")
}

model FeeStructure {
  id             String   @id @default(cuid())
  organizationId String
  classId        String?
  name           String   // Tuition Fee, Transport Fee, etc.
  amount         Decimal  @db.Decimal(15, 2)
  frequency      String   // monthly, quarterly, yearly, one_time
  academicYear   String
  dueDay         Int?     // Day of month when due
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id])
  payments     FeePayment[]

  @@map("fee_structures")
}

model FeePayment {
  id             String   @id @default(cuid())
  studentId      String
  feeStructureId String
  amount         Decimal  @db.Decimal(15, 2)
  paidAmount     Decimal  @db.Decimal(15, 2)
  dueDate        DateTime
  paidDate       DateTime?
  status         String   @default("pending") // pending, paid, partial, overdue
  paymentMethod  String?
  receiptNumber  String?
  remarks        String?
  createdAt      DateTime @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@map("fee_payments")
}

// ============================================================================
// INDUSTRY MODULE: MANUFACTURING
// ============================================================================

model BillOfMaterial {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  finishedProductId String // The product being manufactured
  quantity       Decimal  @db.Decimal(15, 3) // Output quantity
  unit           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items         BomItem[]
  workOrders    WorkOrder[]

  @@unique([organizationId, code])
  @@map("boms")
}

model BomItem {
  id          String  @id @default(cuid())
  bomId       String
  productId   String  // Raw material or component
  quantity    Decimal @db.Decimal(15, 3)
  unit        String
  wastagePercent Decimal @default(0) @db.Decimal(5, 2)

  bom     BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@map("bom_items")
}

model WorkOrder {
  id             String    @id @default(cuid())
  organizationId String
  orderNumber    String
  bomId          String
  quantity       Decimal   @db.Decimal(15, 3)
  plannedStartDate DateTime
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status         String    @default("planned") // planned, in_progress, completed, cancelled
  priority       String    @default("normal") // low, normal, high, urgent
  notes          String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bom               BillOfMaterial    @relation(fields: [bomId], references: [id])
  productionEntries ProductionEntry[]
  qualityChecks     QualityCheck[]

  @@unique([organizationId, orderNumber])
  @@map("work_orders")
}

model ProductionEntry {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String
  machineId      String?
  quantity       Decimal  @db.Decimal(15, 3)
  goodQuantity   Decimal  @db.Decimal(15, 3)
  rejectedQuantity Decimal @default(0) @db.Decimal(15, 3)
  productionDate DateTime
  shiftNumber    Int?
  operatorName   String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id])
  machine      Machine?     @relation(fields: [machineId], references: [id])

  @@map("production_entries")
}

model QualityCheck {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String?
  checkNumber    String
  checkDate      DateTime
  inspectorName  String?
  status         String   @default("pending") // pending, passed, failed
  parameters     Json?    // Quality parameters and values
  remarks        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id])

  @@unique([organizationId, checkNumber])
  @@map("quality_checks")
}

model Machine {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String?
  capacity       String?
  location       String?
  status         String   @default("active") // active, maintenance, inactive
  purchaseDate   DateTime?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionEntries ProductionEntry[]

  @@unique([organizationId, code])
  @@map("machines")
}

// ============================================================================
// INDUSTRY MODULE: RETAIL
// ============================================================================

model Store {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  code           String
  name           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])
  posSessions  PosSession[]

  @@unique([organizationId, code])
  @@map("stores")
}

model PosSession {
  id             String    @id @default(cuid())
  organizationId String
  storeId        String
  cashierId      String
  openingTime    DateTime
  closingTime    DateTime?
  openingBalance Decimal   @db.Decimal(15, 2)
  closingBalance Decimal?  @db.Decimal(15, 2)
  status         String    @default("open") // open, closed
  createdAt      DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store            @relation(fields: [storeId], references: [id])
  transactions PosTransaction[]

  @@map("pos_sessions")
}

model PosTransaction {
  id             String   @id @default(cuid())
  sessionId      String
  transactionNumber String
  customerId     String?
  subtotal       Decimal  @db.Decimal(15, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal  @db.Decimal(15, 2)
  paymentMethod  String   // cash, card, upi
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  session PosSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items   PosTransactionItem[]

  @@map("pos_transactions")
}

model PosTransactionItem {
  id            String  @id @default(cuid())
  transactionId String
  productId     String
  quantity      Decimal @db.Decimal(15, 3)
  unitPrice     Decimal @db.Decimal(15, 2)
  discount      Decimal @default(0) @db.Decimal(15, 2)
  amount        Decimal @db.Decimal(15, 2)

  transaction PosTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("pos_transaction_items")
}

model Promotion {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  type           String   // percentage, fixed, buy_x_get_y
  value          Decimal? @db.Decimal(15, 2)
  minPurchase    Decimal? @db.Decimal(15, 2)
  maxDiscount    Decimal? @db.Decimal(15, 2)
  startDate      DateTime
  endDate        DateTime
  usageLimit     Int?
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@map("promotions")
}

// ============================================================================
// INDUSTRY MODULE: HOSPITAL
// ============================================================================

model Patient {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String    // Hospital registration number
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  bloodGroup     String?
  phone          String?
  email          String?
  address        String?
  city           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalHistory Json?
  allergies      String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([organizationId, patientId])
  @@map("patients")
}

model Doctor {
  id             String   @id @default(cuid())
  organizationId String
  employeeCode   String
  firstName      String
  lastName       String
  specialization String
  qualification  String?
  phone          String?
  email          String?
  consultationFee Decimal? @db.Decimal(15, 2)
  availableDays  String[] // ["monday", "tuesday", ...]
  availableFrom  String?  // "09:00"
  availableTo    String?  // "17:00"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([organizationId, employeeCode])
  @@map("doctors")
}

model Appointment {
  id             String    @id @default(cuid())
  organizationId String
  appointmentNo  String
  patientId      String
  doctorId       String
  appointmentDate DateTime
  appointmentTime String   // "10:30"
  type           String    @default("consultation") // consultation, follow_up, emergency
  status         String    @default("scheduled") // scheduled, confirmed, completed, cancelled
  symptoms       String?
  diagnosis      String?
  prescription   String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])

  @@unique([organizationId, appointmentNo])
  @@map("appointments")
}
